# Copy to .env (git-ignored), then: chmod 600 .env
# Read by every orch command (src/core/env.ts). A value set here wins over the
# shell environment, which only fills keys left empty here.

# decide.claude (catalog/llm.yaml)
ANTHROPIC_API_KEY=

# embed.openai (catalog/llm.yaml): Anthropic has no embedding model.
# platform.openai.com > API keys. The text of every embedded memory goes to OpenAI.
OPENAI_API_KEY=

# Memory brain (catalog/brain.yaml): `orch brain init` generates every value
# below that is missing and never replaces one already set. Losing
# BRAIN_BACKUP_PASSPHRASE makes the encrypted backups unreadable: keep a copy
# outside this machine.
BRAIN_PG_ADMIN_PASSWORD=
BRAIN_BACKUP_PASSPHRASE=
HINDSIGHT_PG_PASSWORD=
# Optional API bearer token, only when Hindsight API authentication is enabled.
HINDSIGHT_API_TOKEN=
# One pair per domain: BRAIN_<DOMAIN>_RO_PASSWORD (recall), BRAIN_<DOMAIN>_RW_PASSWORD (ingestion)
BRAIN_PROJETS_RO_PASSWORD=
BRAIN_PROJETS_RW_PASSWORD=
BRAIN_MAILS_RO_PASSWORD=
BRAIN_MAILS_RW_PASSWORD=
BRAIN_CLIENTS_RO_PASSWORD=
BRAIN_CLIENTS_RW_PASSWORD=
BRAIN_VOYAGES_RO_PASSWORD=
BRAIN_VOYAGES_RW_PASSWORD=
BRAIN_COMPTA_RO_PASSWORD=
BRAIN_COMPTA_RW_PASSWORD=

# Notifications (catalog/presence.yaml `notify`). Telegram: a bot from
# @BotFather and the chat it writes to.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Discord: channel settings > Integrations > Webhooks > New webhook, copy URL.
DISCORD_WEBHOOK_URL=
