# Installed by orch (`orch install`), removed by `orch uninstall`.
#
# A Codex lead runs in the workspace-write sandbox: .git is read-only, the
# home directory is read-only and the network is off. `lane` must write a git
# worktree and its state under ~/.local/state/orch, and the workers it starts
# need the network; `orch mem` and `orch docs` write their stores under the
# home directory. So these run outside the sandbox.
#
# `lane run` asks the operator each time: it executes the spec's SETUP and
# VERIFY commands on the host, unconfined, so an unprompted allow would hand
# the sandboxed lead an unrestricted shell. `lane review`, `status` and `gc`
# run no spec command (review starts a read-only worker) and need no prompt.
#
# Codex matches the command's argument list: call them as plain commands
# (no redirection, no `VAR=` prefix, no `$(...)`), or the rule does not apply.

prefix_rule(
    pattern = ["lane", "run"],
    decision = "prompt",
    justification = "lane run executes the spec's SETUP and VERIFY on the host, outside any sandbox: check the spec before approving",
    match = ["lane run --to grok --spec /tmp/spec.md"],
    not_match = ["lanes run --to grok", "lane gc"],
)

prefix_rule(
    pattern = ["lane", ["review", "status", "gc"]],
    decision = "allow",
    justification = "orch lane: worktree and state outside the workspace, no spec command runs",
    match = [
        "lane review --base main --goal check",
        "lane gc --drop 20261020130737-codex-1-abcd",
        "lane status",
    ],
    not_match = [
        "lane run --to grok --spec /tmp/spec.md",
        "lane rm -rf /",
    ],
)

prefix_rule(
    pattern = ["orch", ["mem", "docs"]],
    decision = "allow",
    justification = "orch memory and docs stores live under the home directory",
    match = [
        "orch mem search lane",
        "orch docs search worktree --stack react",
    ],
    not_match = [
        "orch install",
        "orch uninstall",
    ],
)
